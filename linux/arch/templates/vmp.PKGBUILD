# Generated in a temporary workspace by scripts/package-tools.py.
pkgname=vmp
pkgver='${VERSION}'
pkgrel=1
pkgdesc='Manage Python versions'
arch=('${ARCH}')
url='https://github.com/UekoMundo/repo'
options=('!strip' '!debug')
source=('vmp')
sha256sums=('${BINARY_SHA256}')

package() {
    install -Dm755 vmp "$$pkgdir/usr/bin/vmp"
}
